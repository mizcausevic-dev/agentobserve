PORT=3001
NODE_ENV=development
LOG_LEVEL=info

# Cost anomaly thresholds (multiplier vs baseline P95)
COST_ANOMALY_THRESHOLD=2.5
COST_BUDGET_WARN_PCT=0.80
COST_BUDGET_BLOCK_PCT=1.00

# Regression detection
LATENCY_REGRESSION_THRESHOLD=1.5
OUTPUT_DRIFT_THRESHOLD=0.30
LOOP_DETECTION_MAX_REPEATS=4

# SLA defaults (override per agent)
SLA_DEFAULT_LATENCY_P95_MS=8000
SLA_DEFAULT_SUCCESS_RATE=0.95

# Optional: external alerting webhook
ALERT_WEBHOOK_URL=
